{
  "expo": {
    "name": "Bosko",
    "slug": "Bosko",
    "owner": "apps-frank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bosko-logo.png",
    "scheme": "bosko",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "splash": {
      "image": "./assets/images/bosko-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#850021"
    },
    "newArchEnabled": true,
    "android": {
      "package": "com.boskoapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.boskoapp.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Bosko necesita acceso a la cámara para que puedas subir fotos y videos de tus servicios.",
        "NSPhotoLibraryUsageDescription": "Bosko necesita acceso a tu galería para que puedas subir fotos y videos de tus servicios.",
        "NSPhotoLibraryAddUsageDescription": "Bosko necesita permiso para guardar fotos en tu galería.",
        "NSMicrophoneUsageDescription": "Bosko necesita acceso al micrófono para que puedas grabar y enviar mensajes de voz.",
        "NSFaceIDUsageDescription": "Bosko usa Face ID para desbloquear la app de forma segura y rápida."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bosko-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#850021"
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/bosko-logo.png",
          "color": "#850021",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bosko necesita acceso a tu galería para subir fotos y videos de tus servicios.",
          "cameraPermission": "Bosko necesita acceso a la cámara para subir fotos y videos de tus servicios.",
          "microphonePermission": "Bosko necesita acceso al micrófono para grabar videos."
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      [
        "@didit-protocol/sdk-react-native",
        {
          "iosNfcEnabled": false,
          "androidNfcEnabled": false
        }
      ],
      "expo-asset",
      "@sentry/react-native",
      "expo-navigation-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bosko usa tu ubicación para ubicar tu perfil cuando vos lo solicites."
        }
      ],
      "./plugins/withBouncyCastleFix",
      "./plugins/withManifestBackupFix"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e1513092-becc-4c7c-9524-a3ede8d34829"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#000000"
      },
      "eas": {
        "projectId": "e1513092-becc-4c7c-9524-a3ede8d34829"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light"
    }
  }
}
