{
  "name": "bosko-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "adb-reverse": "PORT=$(adb mdns services 2>/dev/null | grep '_adb-tls-connect._tcp' | head -1 | awk '{print $NF}') && adb connect $PORT && adb -s $PORT reverse tcp:8081 tcp:8081 && echo \"Reverse OK: $PORT\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false --runInBand --watchman=false",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "lint": "eslint src app __tests__",
    "contracts:generate": "openapi-typescript docs/backend-openapi.json -o src/core/api/generated/schema.ts",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- src/core/api/generated/schema.ts",
    "build:check": "expo export --platform android --platform ios --output-dir dist-check",
    "routes:generate": "node scripts/generate-routes.cjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/tests/e2e/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "roots": [
      "<rootDir>/__tests__"
    ]
  },
  "dependencies": {
    "@didit-protocol/sdk-react-native": "^4.0.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native/metro-babel-transformer": "^0.85.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.18.1",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.7",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.48.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.13",
    "eslint": "^9.39.5",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "openapi-typescript": "^7.13.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
}
