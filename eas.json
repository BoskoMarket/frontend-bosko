{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "node": "22.20.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.boskoapp.site/api/v1"
      }
    },
    "preview": {
      "node": "22.20.0",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.boskoapp.site/api/v1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "node": "22.20.0",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.boskoapp.site/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
